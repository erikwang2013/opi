# 打包产物（scripts/build-packages.sh 的输出）。可再生的构建输出，不入库 ——
# 入库只会多一份会漂的副本。
# 注：它的**工作目录**默认落在仓库外（见该脚本里 WORK_DIR 那段注释：在仓库内建
# 构建目录会让 CMake 的编译器探测产物被 500 行门禁扫到），所以这里不需要它的条目。
dist/

# HarmonyOS 构建产物与本地工具缓存（可再生产物，不入库）。
# Rust 静态库 libopi_ffi.a 由 CI/本地用 cargo 生成后拷贝到这里（见 workflow）。
harmony/.hvigor/
harmony/oh_modules/
harmony/entry/oh_modules/
harmony/entry/build/
harmony/entry/.cxx/
harmony/entry/src/main/cpp/libs/
# HarmonyOS 随包词库：构建期由 scripts/prepare_harmony_dicts.sh 从
# android/app/src/main/assets/ 复制到 rawfile，**复制品不入库**（大文件、可再生）。
harmony/entry/src/main/resources/rawfile/*.opid
harmony/local.properties
harmony/.idea/

# packages.yml 里 desktop-deb job 产物的**中转目录**（CI 里是 download-artifact 的
# path，本地复刻打包流程时同样要放一份）；纯暂存，不入库。
desktop-deb/
