// 完整 module.json5（2026-10-19 由 harmony/module.json5 的片段补全为可构建工程）。
// 原片段里的两处不确定项仍按当时的选择保留：
//   · metadata name 用 "ohos.extension.input_method"（点号版）
//   · srcEntry（新写法，非 srcEntrance）
// 真机若出现「能选输入法但子类型不出现」，先按 SDK 模板核对这两处。
{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "InputMethodService",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "requestPermissions": [
      {
        // 更新检测 + 跨设备剪贴板：INTERNET 同时覆盖 UDP 组播发现与 TCP 传输；
        // HarmonyOS 没有单独的「局域网组播」权限可声明。
        "name": "ohos.permission.INTERNET"
      }
      // 不声明 ohos.permission.READ_PASTEBOARD：它是 system_basic + user_grant + ACL，
      // 普通应用声明会导致安装失败。写入剪贴板无需权限；读取只在用户点击设置页的
      // PasteButton（系统安全控件）时获得一次性临时授权。身份/信任文件由内核写在
      // 应用私有目录 ctx.filesDir/clip，不需要任何存储权限。
    ],
    "extensionAbilities": [
      {
        "srcEntry": "./ets/InputMethodExtensionAbility/InputMethodService.ets",
        "name": "InputMethodService",
        "icon": "$media:icon",
        "label": "$string:MainAbility_label",
        "description": "$string:extension_ability_descriptor",
        "type": "inputMethod",
        "exported": true,
        "metadata": [
          {
            "name": "ohos.extension.input_method",
            "resource": "$profile:input_method_config"
          }
        ]
      }
    ]
  }
}
