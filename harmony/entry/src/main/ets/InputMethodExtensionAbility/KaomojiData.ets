// 数据改了必须重跑 —— 本文件是那一次运行的快照，不会自己跟着变。

/**
 * 一个颜文字分类。字段与 Android `KaomojiCategories.Category` 一一对应：
 * `start` 是拼平列表里的累计下标，`items` 的表序 = 源文件序。
 */
export class KaomojiCategory {
  label: string;
  start: number;
  count: number;
  items: string[];

  constructor(label: string, start: number, count: number, items: string[]) {
    this.label = label;
    this.start = start;
    this.count = count;
    this.items = items;
  }
}

