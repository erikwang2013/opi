<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 版本检测（2026-10-22）：只访问 opi.erik.xyz 的 version.json / 首页，不上传用户数据。
         INTERNET 是普通权限，安装即授、无运行时弹窗。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 应用内更新（2026-10-31）：下载完 APK 后拉起系统安装器；无此权限 Android 8+
         会拒绝安装来源。只下载/打开，不静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- 离线语音输入（2026-11-01）：只在前台 IME 窗口录音，不起前台服务；Android 12+
         的系统麦克风指示由 AudioRecord(VOICE_RECOGNITION) 自动显示。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- 跨设备剪贴板（2026-11-01，默认关闭）：UDP 组播发现需要组播锁，内核监听需要
         前台服务。INTERNET 已在上面。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- Android 13+ 通知运行时权限：拒绝也不阻止服务，只是通知不可见。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="小欧输入法"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <!-- 设置入口（A5）：launcher 即设置页，与 IME 共享 Rust 静态单例引擎。 -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="小欧输入法"
            android:theme="@style/LaunchTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 透明权限页：IME 是 Service，不能自己弹运行时权限。授权后只回结果，不常驻。 -->
        <activity
            android:name=".asr.AsrPermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <!-- 自有表情 = 插入 PNG：commitContent 把 cacheDir/pet 下的文件以 content:// 暴露给编辑框。
             authority 与 PetStickerCommit.kt 的 "${packageName}.fileprovider" 一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- APK 覆盖安装后结束旧进程，让新代码/新 .so 生效（见 PackageReplacedReceiver）。
             exported=false 仍能收到系统广播（android:exported 对 receiver 的定义：
             非导出只收系统、本应用与同 UID 的消息）。 -->
        <receiver
            android:name=".PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>
        <service
            android:name=".OpiImeService"
            android:label="小欧输入法"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
        <!-- 跨设备剪贴板的 connectedDevice 前台服务（默认不启动，设置页开关拉起）。
             类型资格由 CHANGE_WIFI_MULTICAST_STATE 满足（Android 14 的要求）。 -->
        <service
            android:name=".clip.ClipSyncService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
