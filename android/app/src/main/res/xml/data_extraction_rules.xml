<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 的备份/换机迁移规则。filesDir/clip 里是设备身份私钥与信任表：
     云备份与设备迁移都不带走 —— 同一身份出现在两台设备上会破坏实例 ID 与信任语义。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="clip/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="clip/" />
    </device-transfer>
</data-extraction-rules>
