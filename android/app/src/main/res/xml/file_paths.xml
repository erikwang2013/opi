<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider 暴露范围：cacheDir/pet（自有表情 PNG，见 PetStickerCommit.kt）与
     入站传输暂存目录。授权本身由调用方按次 grant。 -->
<paths>
    <cache-path name="pet" path="pet/" />
    <!-- 传输导入失败时文件留在应用专属暂存目录；允许用户从传输记录直接打开。 -->
    <external-files-path name="transfer-incoming" path="transfer-incoming/" />
    <files-path name="transfer-incoming-files" path="transfer-incoming/" />
</paths>
